<!--定义Mapper映射文件的约束和基本结构-->
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.my.hostipal.mapper.UserMapper">
    <select id="selectScheduleList" resultType="com.my.hostipal.pojo.entity.Schedule">
        select * from schedule where schedule_date between #{startDate} and #{endDate}
    </select>
</mapper>